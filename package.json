{
  "name": "xl-example",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "一套语言前端的 xl 规范：*.xl.md → dist/ts/**/*.ts → build/ts/**/*.js，另带一个命令行入口 cjcli",
  "bin": {
    "cjcli": "./bin/cjcli.js"
  },
  "scripts": {
    "check": "xl check",
    "build": "xl build && tsc",
    "compile": "tsc",
    "samples": "node ./samples/check.mjs",
    "cjcli": "node ./build/ts/cjcli.js",
    "cases:check": "node ./tests/parse/validate.mjs",
    "cases:run": "node ./tests/parse/run.mjs",
    "cases:diff": "node ./tests/parse/differential.mjs",
    "cases:matrix": "node ./tests/parse/matrix.mjs",
    "cases:lossless": "node ./tests/parse/lossless.mjs",
    "cases:structure": "node ./tests/parse/structure.mjs",
    "cases:boundaries": "node ./tests/parse/boundaries.mjs",
    "cases:noise": "node ./tests/parse/noise.mjs",
    "cases:align": "node ./tests/parse/align.mjs",
    "cases:sweep": "node ./tests/parse/sweep.mjs",
    "cases:recon": "node ./tests/parse/recon.mjs",
    "cases:recon2": "node ./tests/parse/recon2.mjs",
    "cases:fuzz": "node ./tests/parse/fuzz.mjs",
    "cases:fuzz3": "node ./tests/parse/fuzz3.mjs",
    "cases:dashboard": "node ./tests/parse/gap-dashboard.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.3.0"
  }
}
