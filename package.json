{
  "name": "xl-example",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "一套语言前端的 xl 规范：*.xl.md → dist/ts/**/*.ts → build/ts/**/*.js，另带一个命令行入口 cjcli",
  "bin": {
    "cjcli": "./bin/cjcli.js",
    "tsrun": "./bin/tsrun.js"
  },
  "scripts": {
    "check": "xl check",
    "build": "xl build && tsc",
    "compile": "tsc",
    "gates": "node ./tests/gates/run.mjs",
    "samples": "node ./samples/check.mjs",
    "cjcli": "node ./build/ts/cjcli.js",
    "tsrun": "node ./build/ts/tsrun.js",
    "cases:check": "node ./tests/parse/validate.mjs",
    "cases:tags": "node ./tests/parse/tags.mjs",
    "cases:shapes": "node ./tests/parse/shapes.mjs",
    "runtime:check": "node ./tests/runtime/check.mjs",
    "runtime:cli": "node ./tests/runtime/run-cli.mjs",
    "cases:tsast": "node ./tests/parse/ts-ast.mjs",
    "cases:astjson": "node ./tests/parse/ast-json.mjs",
    "cases:tsast:cases": "node ./tests/parse/ts-ast.mjs cases",
    "cases:tsast:cli": "node ./tests/parse/ts-ast.mjs --cli",
    "coverage": "node ./tests/coverage/run.mjs",
    "coverage:sweep": "node ./tests/coverage/sweep.mjs",
    "cpp:check": "node tests/cpp/check.mjs",
    "gates:verbose": "node ./tests/gates/run.mjs --verbose"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.3.0"
  }
}
