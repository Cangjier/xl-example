{
  "name": "xl-example",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "一套语言前端的 xl 规范：*.xl.md → dist/ts/**/*.ts → build/ts/**/*.js，另带一个命令行入口 cjcli",
  "bin": {
    "cjcli": "./bin/cjcli.js"
  },
  "scripts": {
    "check": "xl check",
    "build": "xl build && tsc",
    "compile": "tsc",
    "gates": "node ./tests/gates/run.mjs",
    "samples": "node ./samples/check.mjs",
    "cjcli": "node ./build/ts/cjcli.js",
    "tsrun": "node ./build/ts/tsrun.js",
    "cases:check": "node ./tests/parse/validate.mjs",
    "ast:cases": "node ./typescript/cases/ast-json.mjs && node ./typescript/cases/ast-json-diff.mjs",
    "ast:token": "node ./typescript/cases/token-ast.mjs",
    "ast:dts": "node ./typescript/cases/real-dts-ast.mjs",
    "ast:wide": "node ./tests/parse/wide-ast.mjs",
    "ast:verify": "npm run ast:cases && npm run ast:dts && npm run ast:wide",
    "wide-ast": "node ./tests/parse/wide-ast.mjs",
    "real-dts-ast": "node ./typescript/cases/real-dts-ast.mjs",
    "runtime:check": "node ./tests/runtime/check.mjs",
    "runtime:cli": "node ./tests/runtime/run-cli.mjs",
    "cases:tsast": "node ./tests/parse/ts-ast.mjs",
    "cases:direct": "node ./tests/parse/direct-ast.mjs",
    "direct:lint": "node ./tests/parse/direct-lint.mjs",
    "cases:tsast:cases": "node ./tests/parse/ts-ast.mjs cases",
    "cases:tsast:cli": "node ./tests/parse/ts-ast.mjs --cli",
    "coverage": "node ./tests/coverage/run.mjs",
    "coverage:sweep": "node ./tests/coverage/sweep.mjs",
    "cpp:check": "node tests/cpp/check.mjs",
    "gates:verbose": "node ./tests/gates/run.mjs --verbose",
    "tts": "node ./tests/parse/token-time-shapes.mjs ./tests/parse/token-time-shapes/let-x.ts --diff"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.3.0"
  }
}
