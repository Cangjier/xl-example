{
  "schema": 1,
  "description": "语句 possible 仪器用例（设计 §7.1）。分组按 Stage 归属；needs 表明该组依赖的运行期能力，能力缺失时整组 skip 并打印原因。",
  "groups": {
    "stage4-block": {
      "stage": "Stage 4a (block statement shell)",
      "description": "Block statement shell: `{}`, `{ let x = 1; f(); }`, `{ if (a) b; }`, nested block, in-block ASI, in-block comment, function / method body, `{ \"s\"; }`, `{ a.b; }`, two blocks in a row, `({ a: 1 });`. Same cases as block-cases.json.",
      "needs": ["root:BlockPossibleShape"],
      "cases": [
        { "name": "block-empty", "source": "{}" },
        { "name": "block-let-call", "source": "{ let x = 1; f(); }" },
        { "name": "block-if", "source": "{ if (a) b; }" },
        { "name": "block-nested", "source": "{ { a; } }" },
        { "name": "block-asi", "source": "{ let a = 1\nlet b = 2\nf() }" },
        { "name": "block-comment", "source": "{ // c\n a; /* d */ }" },
        { "name": "block-string", "source": "{ \"s\"; }" },
        { "name": "block-member", "source": "{ a.b; }" },
        { "name": "block-func-body", "source": "function f() { let x = 1; }" },
        { "name": "block-method-body", "source": "class C { m() { a; } }" },
        { "name": "block-two", "source": "{ a; }\n{ b; }" },
        { "name": "block-object-vs-block", "source": "({ a: 1 });" }
      ]
    },
    

    "stage1": {
      "stage": "Stage 1（T1d 接线后生效）",
      "description": "普通表达式起点走语句壳 + legacy 混排",
      "needs": ["root:RootExpressionStatementPossibleShape"],
      "cases": [
        { "name": "stage1-let", "source": "let x = 1;" },
        { "name": "stage1-call", "source": "f();" },
        { "name": "stage1-ident", "source": "a" },
        { "name": "stage1-two-idents", "source": "a\nb" },
        { "name": "stage1-precedence", "source": "1*2+3;" },
        { "name": "stage1-paren", "source": "(a);" },
        { "name": "stage1-array", "source": "[a];" },
        { "name": "stage1-prefix", "source": "!a;" },
        { "name": "stage1-let-if-mix", "source": "let a = 1\nif (a) b;" },
        { "name": "stage1-mixed", "source": "let a = 1\nf();\nconst b = 2;" },
        { "name": "stage1-import-export-mix", "source": "import x from \"m\";\nlet a = 1;\nexport { x };" },
        { "name": "stage1-no-semicolon-tail", "source": "let a = 1\nlet b = 2\nf()" }
      ]
    },
    "asi": {
      "stage": "全阶段（ASI 判据回归；基线可跑）",
      "description": "换行 / 无分号 / 行尾注释处的语句边界",
      "needs": [],
      "cases": [
        { "name": "asi-ident-newline", "source": "a\nb" },
        { "name": "asi-return-newline", "source": "function f() { return\nx; }" },
        { "name": "asi-prefix-next-line", "source": "a\n++b" },
        { "name": "asi-postfix-newline", "source": "a++\nb" },
        { "name": "asi-let-let", "source": "let a = 1\nlet b = 2" },
        { "name": "asi-type-then-return", "source": "type T = A\nreturn;", "allowTsDiagnostics": true },
        { "name": "asi-debugger-block", "source": "function f(){ debugger\n{a:1} }" },
        { "name": "asi-line-comment", "source": "a // c\nb" },
        { "name": "asi-block-close", "source": "function f() { let x = 1\n}" },
        { "name": "asi-call-next-line", "source": "a\n(b)" },
        { "name": "asi-comment-between", "source": "let a = 1\n/*c*/ f()" },
        { "name": "asi-if-else-block", "source": "function f(){ if (a) b\nelse c }" }
      ]
    },
    "trivia": {
      "stage": "全阶段（trivia 首格 / 注释 / BOM；基线可跑）",
      "description": "首格注释、块注释跨行、BOM、空白开头、关键字与绑定之间的注释",
      "needs": [],
      "cases": [
        { "name": "trivia-leading-line-comment", "source": "// c\nlet x = 1;" },
        { "name": "trivia-leading-block-comment", "source": "/* c\n   d */ let x = 1;" },
        { "name": "trivia-bom", "source": "\uFEFFlet x = 1;" },
        { "name": "trivia-leading-blank", "source": "  \n\n  let x = 1;" },
        { "name": "trivia-between-keyword-binding", "source": "let /*c*/ x = 1;" },
        { "name": "trivia-between-binding-equal", "source": "let x /*c*/ = 1;" },
        { "name": "trivia-comment-before-expr", "source": "// c\nf();" },
        { "name": "trivia-block-before-expr", "source": "/* c */ a" }
      ]
    },
    "route": {
      "stage": "Stage 1（T1d StatementRouteUtil 落地后生效）",
      "description": "表达式 / 声明 / 双角色起点的分流",
      "needs": ["module:statement-route-util"],
      "cases": [
        { "name": "route-async-arrow", "source": "async () => {}" },
        { "name": "route-async-function", "source": "async function f(){}" },
        { "name": "route-import-call", "source": "import(\"x\")" },
        { "name": "route-import-meta", "source": "import.meta.url" },
        { "name": "route-import-decl", "source": "import x from \"y\"" },
        { "name": "route-using", "source": "using x = y;", "allowTsDiagnostics": true },
        { "name": "route-type-alias", "source": "type X = 1" },
        { "name": "route-let-label", "source": "let: while(1){}" },
        { "name": "route-brace-block", "source": "{a:1}" },
        { "name": "route-let-equals", "source": "let = 1", "allowTsDiagnostics": true },
        { "name": "route-let-call", "source": "let(a)" },
        { "name": "route-let-decl", "source": "let x = 1" },
        { "name": "route-const-decl", "source": "const x = 1" },
        { "name": "route-var-decl", "source": "var x = 1" }
      ]
    },
    "satisfies": {
      "stage": "全阶段（A 的 4 个 diff 根因形态；基线可跑）",
      "description": "satisfies / 类型实参二义 / 解构计算键",
      "needs": [],
      "cases": [
        { "name": "satisfies-expr", "source": "x satisfies T;" },
        { "name": "satisfies-type-arg-ambig", "source": "a<b>;", "allowTsDiagnostics": true },
        { "name": "satisfies-record-annot", "source": "const t: Record<string, number> = {};" },
        { "name": "satisfies-decl-instantiation-line-end", "source": "let a: Foo<Bar>;\nlet b = 1;" },
        { "name": "satisfies-decl-instantiation-no-semicolon", "source": "let a: Foo<Bar>\nlet b = 1;", "knownBaselineFail": true },
        { "name": "satisfies-gap-instantiation-line-end", "source": "let a = new Foo<Bar>()\nlet b = 1" },
        { "name": "satisfies-decl-obj-destructure-computed-key", "source": "const {[k]: v} = o;" },
        { "name": "satisfies-ty-satisfies", "source": "const x = y satisfies T;" },
        { "name": "satisfies-as-then-let", "source": "let a = b as T\nlet c = 1" }
      ]
    },
    "operators": {
      "stage": "Stage 3（操作符 possible 接入壳体后成为硬门；基线以 legacy 路径对拍）",
      "description": "优先级 / 结合性 / 一元 / 赋值 / 条件 / 成员链",
      "needs": [],
      "cases": [
        { "name": "op-mul-add", "source": "1*2+3" },
        { "name": "op-add-mul", "source": "a+b*c" },
        { "name": "op-left-assoc", "source": "a-b-c" },
        { "name": "op-right-assoc", "source": "a**b**c" },
        { "name": "op-paren", "source": "a*(b+c)" },
        { "name": "op-unary-bin", "source": "-a+b" },
        { "name": "op-not-and", "source": "!a&&b" },
        { "name": "op-plusplus-plus", "source": "a+++b" },
        { "name": "op-assign-chain", "source": "x = y = 1" },
        { "name": "op-compound-assign", "source": "x += 1" },
        { "name": "op-conditional", "source": "a?b:c" },
        { "name": "op-conditional-chain", "source": "a?b:c?d:e" },
        { "name": "op-member-chain", "source": "f(x)[0].y" },
        { "name": "op-optional-call", "source": "f?.()" },
        { "name": "op-new-member", "source": "new X().y" },
        { "name": "op-mixed-arith", "source": "a+b*c-d/e" },
        { "name": "op-instanceof", "source": "x instanceof Y" },
        { "name": "op-in", "source": "\"k\" in o" }
      ]
    },
    "stage4": {
      "stage": "Stage 4（其余语句族壳化后生效）",
      "description": "控制流语句族与块体内语句目录",
      "needs": ["root:IfStatementPossibleShape"],
      "cases": [
        { "name": "stage4-function-local-let", "source": "function f(){ let x=1; }" },
        { "name": "stage4-if-else", "source": "if(x) y; else z;" },
        { "name": "stage4-while", "source": "while(a) b;" },
        { "name": "stage4-for", "source": "for(let i=0;i<3;i++){}" },
        { "name": "stage4-for-of", "source": "for(x of o){}" },
        { "name": "stage4-switch", "source": "switch(x){case 1: break;}" },
        { "name": "stage4-try-catch", "source": "try{a}catch(e){b}" },
        { "name": "stage4-do-while", "source": "do a; while(b);" },
        { "name": "stage4-block-comment-first", "source": "function f(){ /* c */ let x = 1; }" },
        { "name": "stage4-object-vs-block", "source": "({a:1});" }
      ]
    },
    "stage5": {
      "stage": "Stage 5（声明 possible 三层落地后生效）",
      "description": "声明列表 / 解构 / 多声明 / declare",
      "needs": ["shell-body-candidates"],
      "cases": [
        { "name": "stage5-let-list", "source": "let a=1,b=2;" },
        { "name": "stage5-obj-destructure", "source": "const {a,b:c}=o;" },
        { "name": "stage5-array-destructure", "source": "let [x]=a;" },
        { "name": "stage5-let-type-annot", "source": "let x: T;" },
        { "name": "stage5-let-let-asi", "source": "let x=1\nlet y=2" },
        { "name": "stage5-declare-let", "source": "declare let x: number;" },
        { "name": "stage5-three-declarators", "source": "let a = 1, b = 2, c = 3;" },
        { "name": "stage5-destructure-default", "source": "const {a = 1} = o;" }
      ]
    },
    "stage4b": {
      "stage": "Stage 4b (block body statements taken over by possible)",
      "description": "Block body takeover: mixed let/expression body, two calls, nested block, in-block ASI, two blocks in a row, `let a = 1` newline `{ b; }` (ASI boundary before a block), mixed body, uncovered control flow inside a block (safe fallback or legacy), empty statement inside a block, three expression statements.",
      "needs": ["root:BlockPossibleShape"],
      "cases": [
        { "name": "s4b-let-call", "source": "{ let x = 1; f(); }" },
        { "name": "s4b-two-calls", "source": "{ f(); g(); }" },
        { "name": "s4b-nested-block", "source": "{ { a; } }" },
        { "name": "s4b-asi", "source": "{ let a = 1\nlet b = 2\nf() }" },
        { "name": "s4b-two-blocks", "source": "{ a; }\n{ b; }" },
        { "name": "s4b-mixed", "source": "{ let a = 1; f(); b; }" },
        { "name": "s4b-control-flow", "source": "{ if (a) b; }" },
        { "name": "s4b-empty", "source": "{ ; }" },
        { "name": "s4b-three", "source": "{ a; b; c; }" }
      ]
    }
  }
}
