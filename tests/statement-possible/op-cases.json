            ],
            "minInserts": 1
          }
        },
        {
          "name": "live-cond-right",
          "source": "a ? b : c ? d : e;",
          "note": "条件右结合：假分支再嵌一层",
          "operatorShapes": {
            "texts": [
              "?(a,b,?(c,d,e))"
            ],
            "minInserts": 2
          }
        },
        {
          "name": "live-cond-true",
          "source": "a ? b ? c : d : e;",
