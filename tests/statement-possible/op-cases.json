    "stage3h-live": {
      "description": "S3h 专用 cases：赋值 / 复合赋值（优先级 0、右结合、经 ShapeInsertUtil.InsertBetween 增量插入）、条件 ?:（优先级 1 的帧 + Conditionals 栈）、后缀 ++/--（运算符不进 children）；每条都要求壳路径 XML 与同源码 legacy 逐字节一致、结构文本逐字相符、插入次数达标。",
      "needs": [],
      "cases": [
        {
          "name": "live-assign",
          "source": "x = 1;",
          "note": "赋值：左操作数已就绪、遇 = 建右结合最低优先级帧",
          "operatorShapes": {
            "texts": [
              "=(x,1)"
            ],
            "minInserts": 1
          }
        },
        {
          "name": "live-compound",
          "source": "x += 1;",
          "note": "复合赋值 += ",
          "operatorShapes": {
            "texts": [
              "+=(x,1)"
            ],
            "minInserts": 1
          }
        },
        {
          "name": "live-chain",
          "source": "a = b = 1;",
          "note": "连续赋值右结合：=(a,=(b,1))",
          "operatorShapes": {
            "texts": [
              "=(a,=(b,1))"
            ],
            "minInserts": 2
          }
        },
        {
          "name": "live-precedence",
          "source": "x *= y + 1;",
          "note": "赋值优先级最低：右支收进整条二元",
          "operatorShapes": {
            "texts": [
              "*=(x,+(y,1))"
            ],
            "minInserts": 2
          }
        },
        {
          "name": "live-member",
          "source": "a.b = 1;",
