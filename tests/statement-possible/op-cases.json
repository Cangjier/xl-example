{
  "groups": {
    "operators-live": {
      "description": "S3a+S3b 实时操作符体（专用 cases）：壳内按格建操作数叶子 / 二元节点，遇不高于栈顶的优先级时用 ShapeInsertUtil.InsertBetween 增量插入；判据 = XML 与同源码 legacy（开关 false）逐字节一致 + 无文件级 fallback + 壳里不泄漏节点。结构判据（+(*(1,2),3) 等）与 InsertBetween 计数由同目录的 op-proof.mjs 用同一份 cases 复核。",
      "needs": [],
      "cases": [
        {
          "name": "op-mul-add",
          "source": "1*2+3;",
          "note": "S3b 核心：乘先建、加来了把乘包成左操作数 → +(*(1,2),3)",
          "operatorShapes": {
            "texts": [
              "+(*(1,2),3)"
            ],
            "minInserts": 2
          }
        },
        {
          "name": "op-add-mul",
          "source": "a+b*c;",
          "note": "低优先级先到、高优先级后到：新节点插进 + 与 b 之间",
          "operatorShapes": {
            "texts": [
              "+(a,*(b,c))"
            ],
            "minInserts": 2
          }
        },
        {
          "name": "op-sub-left",
          "source": "a-b-c;",
          "note": "同优先级左结合：先弹栈再插入 → -(-(a,b),c)",
          "operatorShapes": {
            "texts": [
              "-(-(a,b),c)"
            ],
            "minInserts": 2
          }
        },
        {
          "name": "op-paren",
          "source": "a*(b+c);",
          "note": "圆括号操作数：括号里的单元整段喂给一个新的本体",
          "operatorShapes": {
            "texts": [
              "*(a,(b+c))"
            ],
            "minInserts": 1
          }
        },
        {
          "name": "op-mixed",
          "source": "a+b*c-d/e;",
          "note": "四级优先级混排：两个弹栈 + 三次插入",
          "operatorShapes": {
            "texts": [
              "-(+(a,*(b,c)),/(d,e))"
            ],
            "minInserts": 3
          }
        },
        {
          "name": "op-ident-only",
          "source": "a+b;",
          "note": "最小二元式：插入发生在根持有者与 a 之间",
          "operatorShapes": {
            "texts": [
              "+(a,b)"
            ],
            "minInserts": 1
          }
        },
        {
          "name": "op-div-mul",
          "source": "1/2*3;",
