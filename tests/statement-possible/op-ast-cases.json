{
    "groups": {
        "ast-from-shapes": {
            "description": "S3c 专用证据：受支持表达式语句的 AST 由增量形状树产出（StatementShapeAst），未覆盖构造仍走 legacy。每条断言五件事：①壳路径 XML 与同源码 legacy（EnableShellExpressions=false）逐字节一致；②形状树实际接管了 AST（StatementShapeAst.TotalShapeAst 达到期望条数，不接受「静默回退」）；③形状结构 = TypeScript 自己的 AST 结构（ts.createSourceFile 逐节点渲染成前缀文本后逐字比较）；④未覆盖构造必须 declined 而不是建错树；⑤声明了 astLeaves 的用例，AST 里的数字叶子（NumericLiteralShape 的规范化文本）必须与期望、以及与 ts.createSourceFile 的 NumericLiteral.text 三者一致——数字边界用例靠它钉住「前导点 .5 只能是 NumericLiteral，不能退化成 Identifier」。",
            "needs": [],
            "cases": [
                {
                    "name": "ast-mul-add",
                    "source": "1*2+3;",
                    "note": "最小接管：+(*(1,2),3)，AST 由形状树逐节点组装",
                    "shapeTexts": [
                        "+(*(1,2),3)"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-add-mul",
                    "source": "a+b*c;",
                    "note": "低优先级先到、高优先级后到：+(a,*(b,c))",
                    "shapeTexts": [
                        "+(a,*(b,c))"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-sub-left",
                    "source": "a-b-c;",
                    "note": "同优先级左结合：-(-(a,b),c)",
                    "shapeTexts": [
                        "-(-(a,b),c)"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-paren-right",
                    "source": "a*(b+c);",
                    "note": "括号操作数：*(a,(b+c))，括号内用新的 ExpressionBuilder 载入 bracket.Data",
                    "shapeTexts": [
                        "*(a,(b+c))"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-paren-left",
                    "source": "(a+b)*c;",
                    "note": "括号在左：(a+b) 是 ParenthesizedExpression，跨度取括号单元自己",
                    "shapeTexts": [
                        "*((a+b),c)"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-mixed",
                    "source": "a+b*c-d/e;",
                    "note": "四级优先级混排：-(+(a,*(b,c)),/(d,e))",
                    "shapeTexts": [
                        "-(+(a,*(b,c)),/(d,e))"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-div-mul",
                    "source": "1/2*3;",
                    "note": "同优先级左结合：*(/(1,2),3)",
                    "shapeTexts": [
                        "*(/(1,2),3)"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-ident-only",
                    "source": "a;",
                    "note": "单标识符叶子：形状树就是一片叶子",
                    "shapeTexts": [
                        "a"
                    ],
                    "shapeAst": 1
                },
                {
                    "name": "ast-no-semicolon",
                    "source": "a+b",
                    "note": "文件末尾无分号：判界与 legacy 同一套（本层末尾）",
